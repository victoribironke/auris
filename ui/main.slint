import { ListView } from "std-widgets.slint";

export struct ResultItem {
    title: string,
    subtitle: string,
    glyph: string,
    kind: string,
    primary-label: string,
    can-reveal: bool,
    can-admin: bool,
}

global Theme {
    out property <color> surface: #1c1d21f2;
    out property <color> border: #ffffff1f;
    out property <color> text: #f3f4f6;
    out property <color> text-muted: #9ca3af;
    out property <color> text-faint: #6b7280;
    out property <color> selection: #ffffff14;
    out property <color> hover: #ffffff0a;
    out property <color> accent: #8ab4ff;
    out property <length> row-height: 58px;
}

component KindIcon inherits Rectangle {
    in property <string> glyph;
    in property <color> accent;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: accent.transparentize(0.84);
    border-width: 1px;
    border-color: accent.transparentize(0.75);

    Text {
        text: root.glyph;
        font-family: "Segoe MDL2 Assets";
        font-size: 17px;
        color: root.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Keycap inherits Rectangle {
    in property <string> label;
    height: 20px;
    width: max(20px, caption.preferred-width + 12px);
    border-radius: 5px;
    background: #ffffff12;
    border-width: 1px;
    border-color: #ffffff1a;

    caption := Text {
        text: root.label;
        font-size: 11px;
        color: Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component FooterAction inherits Rectangle {
    in property <string> label;
    in property <string> keys;
    in property <bool> enabled: true;
    callback clicked();

    height: 28px;
    width: caption.preferred-width + cap.width + 24px;
    border-radius: 7px;
    background: touch.has-hover && root.enabled ? Theme.hover : transparent;
    opacity: root.enabled ? 1.0 : 0.35;
    animate opacity, background { duration: 120ms; }

    caption := Text {
        x: 8px;
        width: self.preferred-width;
        height: parent.height;
        text: root.label;
        font-size: 12px;
        color: Theme.text-muted;
        vertical-alignment: center;
    }

    cap := Keycap {
        x: caption.x + caption.width + 8px;
        y: (parent.height - self.height) / 2;
        label: root.keys;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ResultRow inherits Rectangle {
    in property <ResultItem> item;
    in property <bool> selected;
    callback activated();

    property <color> accent: root.item.kind == "App" ? #8ab4ff
        : root.item.kind == "File" ? #7dd3a8
        : root.item.kind == "Folder" ? #f5c46b
        : root.item.kind == "Calculator" ? #c4a1ff
        : root.item.kind == "Web" ? #6fd3e8
        : root.item.kind == "System" ? #ff8f8f
        : root.item.kind == "Command" ? #d6d98a
        : #b8bec9;

    border-radius: 12px;
    background: root.selected ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 100ms; }

    Rectangle {
        x: 0px;
        width: 3px;
        height: root.selected ? 26px : 0px;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: root.accent;
        animate height { duration: 140ms; easing: ease-out; }
    }

    KindIcon {
        x: 14px;
        y: (parent.height - self.height) / 2;
        glyph: root.item.glyph;
        accent: root.accent;
    }

    VerticalLayout {
        x: 66px;
        y: 0px;
        width: parent.width - 66px - badge.width - 28px;
        height: parent.height;
        alignment: center;
        spacing: 2px;

        Text {
            text: root.item.title;
            font-size: 15px;
            font-weight: 500;
            color: Theme.text;
            overflow: elide;
        }

        Text {
            visible: root.item.subtitle != "";
            text: root.item.subtitle;
            font-size: 12px;
            color: Theme.text-muted;
            overflow: elide;
        }
    }

    badge := Text {
        width: 120px;
        x: parent.width - self.width - 16px;
        height: parent.height;
        horizontal-alignment: right;
        vertical-alignment: center;
        text: root.selected ? root.item.primary-label + "  \u{21B5}" : root.item.kind;
        font-size: 12px;
        color: root.selected ? Theme.text-muted : Theme.text-faint;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

export component MainWindow inherits Window {
    title: "Auris";
    icon: @image-url("icon.svg");
    width: 720px;
    height: 520px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI";

    in property <[ResultItem]> results;
    in-out property <int> selected-index: 0;
    in-out property <string> query;
    in property <string> status;
    in property <string> toast;
    in property <bool> toast-is-error;
    in property <bool> indexing;

    callback search-changed(string);
    callback activate(int, string);
    callback hide-requested();
    callback forget-requested(int);
    callback toggle-requested();
    callback show-requested();

    public function focus-search() {
        search-input.focus();
        search-input.select-all();
    }

    public function scroll-to-top() {
        list.viewport-y = 0px;
    }

    function select(index: int) {
        if (root.results.length == 0) {
            root.selected-index = 0;
            return;
        }
        root.selected-index = max(0, min(root.results.length - 1, index));
        if (root.selected-index * Theme.row-height < -list.viewport-y) {
            list.viewport-y = -(root.selected-index * Theme.row-height);
        } else if ((root.selected-index + 1) * Theme.row-height > -list.viewport-y + list.visible-height) {
            list.viewport-y = -((root.selected-index + 1) * Theme.row-height - list.visible-height);
        }
    }

    function move-selection(delta: int) {
        if (root.results.length == 0) {
            return;
        }
        if (root.selected-index + delta < 0) {
            root.select(root.results.length - 1);
        } else if (root.selected-index + delta >= root.results.length) {
            root.select(0);
        } else {
            root.select(root.selected-index + delta);
        }
    }

    forward-focus: search-input;

    FocusScope {
        forward-focus: search-input;

        capture-key-pressed(event) => {
            if (event.text == Key.UpArrow || (event.modifiers.control && event.text == "p")) {
                root.move-selection(-1);
                return accept;
            }
            if (event.text == Key.DownArrow || (event.modifiers.control && event.text == "n")) {
                root.move-selection(1);
                return accept;
            }
            if (event.text == Key.PageUp) {
                root.select(root.selected-index - 5);
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.select(root.selected-index + 5);
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.query != "") {
                    root.query = "";
                    root.search-changed("");
                } else {
                    root.hide-requested();
                }
                return accept;
            }
            if (event.text == Key.Return) {
                if (event.modifiers.control && event.modifiers.shift) {
                    root.activate(root.selected-index, "admin");
                } else if (event.modifiers.control) {
                    root.activate(root.selected-index, "reveal");
                } else if (event.modifiers.shift) {
                    root.activate(root.selected-index, "copy");
                } else {
                    root.activate(root.selected-index, "open");
                }
                return accept;
            }
            if (event.modifiers.control && event.text == Key.Delete) {
                root.forget-requested(root.selected-index);
                return accept;
            }
            if (event.modifiers.alt && event.text.is-float() && event.text != "0") {
                // Alt+1..9 opens the nth visible result.
                root.activate(event.text.to-float() - 1, "open");
                return accept;
            }
            return reject;
        }

        panel := Rectangle {
            x: 10px;
            y: 10px;
            width: parent.width - 20px;
            height: parent.height - 20px;
            border-radius: 18px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000080;
            clip: true;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // Search field
                Rectangle {
                    height: 72px;

                    Text {
                        x: 24px;
                        width: 24px;
                        height: parent.height;
                        text: "\u{E721}";
                        font-family: "Segoe MDL2 Assets";
                        font-size: 18px;
                        color: search-input.has-focus ? Theme.accent : Theme.text-faint;
                        vertical-alignment: center;
                        animate color { duration: 150ms; }
                    }

                    Text {
                        x: search-input.x;
                        width: search-input.width;
                        height: parent.height;
                        visible: root.query == "";
                        text: "Search apps, files, and commands";
                        font-size: 20px;
                        color: Theme.text-faint;
                        vertical-alignment: center;
                    }

                    search-input := TextInput {
                        x: 60px;
                        width: parent.width - 60px - (spinner.visible ? 48px : 24px);
                        height: parent.height;
                        text <=> root.query;
                        font-size: 20px;
                        color: Theme.text;
                        selection-background-color: #8ab4ff55;
                        selection-foreground-color: Theme.text;
                        vertical-alignment: center;
                        single-line: true;
                        edited => {
                            root.search-changed(self.text);
                        }
                    }

                    spinner := Rectangle {
                        visible: root.indexing;
                        x: parent.width - 36px;
                        y: (parent.height - self.height) / 2;
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: Theme.accent;
                        opacity: 0.35 + 0.65 * abs(sin(360deg * animation-tick() / 1200ms));
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                // Results
                Rectangle {
                    vertical-stretch: 1;

                    list := ListView {
                        x: 8px;
                        y: 8px;
                        width: parent.width - 16px;
                        height: parent.height - 16px;

                        for entry[index] in root.results: Rectangle {
                            height: Theme.row-height;

                            ResultRow {
                                y: 1px;
                                height: parent.height - 2px;
                                width: parent.width;
                                item: entry;
                                selected: index == root.selected-index;
                                activated => {
                                    root.selected-index = index;
                                    root.activate(index, "open");
                                }
                            }
                        }
                    }

                    // Empty state
                    Rectangle {
                      visible: root.results.length == 0;

                      VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        Text {
                            text: root.query == "" ? "\u{E721}" : "\u{E783}";
                            font-family: "Segoe MDL2 Assets";
                            font-size: 30px;
                            color: Theme.text-faint;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.query == "" ? "Start typing to search" : "No results for \u{201C}" + root.query + "\u{201D}";
                            font-size: 15px;
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            text: root.query == ""
                                ? "Try an app name, a file, 45 * 12, g weather, or > ipconfig"
                                : "Try a web search: g " + root.query;
                            font-size: 12px;
                            color: Theme.text-faint;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                      }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                // Footer
                Rectangle {
                    height: 44px;
                    background: #00000026;

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 8px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;

                        Text {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            text: root.toast != "" ? root.toast : root.status;
                            font-size: 12px;
                            color: root.toast == "" ? Theme.text-faint : root.toast-is-error ? #ff9b9b : Theme.accent;
                            vertical-alignment: center;
                            overflow: elide;
                            animate color { duration: 150ms; }
                        }

                        FooterAction {
                            label: root.results.length > 0 ? root.results[root.selected-index].primary-label : "Open";
                            keys: "\u{21B5}";
                            enabled: root.results.length > 0;
                            clicked => { root.activate(root.selected-index, "open"); }
                        }

                        FooterAction {
                            label: "Show in folder";
                            keys: "Ctrl \u{21B5}";
                            enabled: root.results[root.selected-index].can-reveal;
                            clicked => { root.activate(root.selected-index, "reveal"); }
                        }

                        FooterAction {
                            label: "Copy";
                            keys: "Shift \u{21B5}";
                            enabled: root.results.length > 0;
                            clicked => { root.activate(root.selected-index, "copy"); }
                        }

                        FooterAction {
                            label: "Admin";
                            keys: "Ctrl Shift \u{21B5}";
                            enabled: root.results[root.selected-index].can-admin;
                            clicked => { root.activate(root.selected-index, "admin"); }
                        }
                    }
                }
            }
        }
    }

    init => {
        search-input.focus();
    }
}
